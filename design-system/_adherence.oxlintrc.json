      "--tl-fg-2",
      "--tl-fg-3",
      "--tl-fg-4",
      "--tl-fg-dark",
      "--tl-fg-inverse",
      "--tl-fg-muted",
      "--tl-font-icon",
      "--tl-font-sans",
      "--tl-fs-2xl",
      "--tl-fs-3xl",
      "--tl-fs-lg",
      "--tl-fs-md",
      "--tl-fs-sm",
      "--tl-fs-xl",
      "--tl-fs-xs",
      "--tl-lh-2xl",
      "--tl-lh-3xl",
      "--tl-lh-lg",
